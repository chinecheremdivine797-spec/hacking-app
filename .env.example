# Copy to .env.local for local development. Do not commit real project configuration.
# Firebase web config values are public identifiers; secure access with Firebase Auth
# and Firestore Security Rules. Never put Admin SDK service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
